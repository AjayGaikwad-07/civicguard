# PostgreSQL
DATABASE_URL=postgresql://civicguard:civicguard@localhost:5432/civicguard

# Anthropic (Claude triage)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Uploads (local filesystem; S3 later)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
